# Copy this file to .env and edit local values.
# Never commit .env because it may contain real passwords or tokens.

# Shared develop runtime example:
COMPOSE_PROJECT_NAME=spatial_log_shared
SAMS_DATA_ROOT=/media/innopam/InnoPAM-8TB/sams-data

# Local development credentials only. Replace these in your private .env.
DB_PASSWORD=change_me_dev_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password

# Default shared-runtime host ports.
POSTGRES_HOST_PORT=7432
STAC_API_HOST_PORT=8080
SAMS_API_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
REDIS_HOST_PORT=6379
FRONTEND_HOST_PORT=3000
NGINX_HOST_PORT=7800

# Personal temporary runtime example:
# Use different values per developer or per branch when running stacks at the same time.
# COMPOSE_PROJECT_NAME=spatial_log_hwiyoung_feature_upload_temp
# SAMS_DATA_ROOT=/media/innopam/InnoPAM-8TB/sams-data-hwiyoung-temp
